[Unit]
Description=SSH link to the S20: Cupboard's internal API (:8086) one way, the job agents' ports the other
After=network-online.target
Wants=network-online.target
ConditionPathExists=!@HOME@/jobagent/STANDBY
StartLimitIntervalSec=0

[Service]
User=@USER@
ExecStart=/usr/bin/ssh -N -o BatchMode=yes -o ExitOnForwardFailure=yes @FORWARDS@ s20phone
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
