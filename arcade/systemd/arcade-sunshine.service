[Unit]
Description=Arcade: Sunshine game streaming of display :1 (Intel VA-API encode)
After=arcade-display.service network-online.target
Requires=arcade-display.service

[Service]
User=gpsingh
Environment=DISPLAY=:1
Environment=HOME=/home/gpsingh
ExecStartPre=/bin/sleep 3
ExecStart=/usr/bin/sunshine /home/gpsingh/.config/sunshine/sunshine.conf
StandardOutput=append:/home/gpsingh/arcade/sunshine.log
StandardError=append:/home/gpsingh/arcade/sunshine.log
Restart=always
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
