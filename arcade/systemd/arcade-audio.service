[Unit]
Description=Arcade: virtual sound card (PulseAudio null sink) so Sunshine can capture game audio

[Service]
User=gpsingh
Environment=XDG_RUNTIME_DIR=/home/gpsingh/arcade/run
ExecStartPre=/bin/mkdir -p /home/gpsingh/arcade/run
ExecStart=/usr/bin/pulseaudio -n --exit-idle-time=-1 --daemonize=no --disable-shm=yes -L "module-native-protocol-unix" -L "module-null-sink sink_name=arcade sink_properties=device.description=Arcade"
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
